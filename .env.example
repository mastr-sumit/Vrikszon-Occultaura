# Database Connection URL (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Resend — transactional email (booking/contact confirmations)
RESEND_API_KEY=""

# Email addresses
ADMIN_NOTIFICATION_EMAIL=""
EMAIL_FROM=""

# NextAuth / Auth.js (v5)
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Admin Seeding (Used when running npm run seed:admin)
SEED_ADMIN_EMAIL="admin@vrikszon.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# Razorpay (Future phase — not wired yet)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ─────────────────────────────────────────────────────────────
# Configurable Rate Limiting & Exponential Backoff Settings
# ─────────────────────────────────────────────────────────────
# Auth Tier (per-IP and per-account thresholds)
RATE_LIMIT_AUTH_IP_MAX="5"                 # Max attempts per IP window
RATE_LIMIT_AUTH_IP_WINDOW_SEC="60"         # IP window duration in seconds
RATE_LIMIT_AUTH_ACCOUNT_MAX="5"            # Max attempts per Account window
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SEC="300"   # Account window duration in seconds
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC="15"      # Base penalty delay in seconds
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER="2"     # Exponential multiplier (e.g. 15s -> 30s -> 60s -> 120s)
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC="3600"     # Maximum backoff lockout ceiling (1 hour)

# Public API Endpoints (Moderate limit)
RATE_LIMIT_PUBLIC_MAX="40"                 # Max requests per window
RATE_LIMIT_PUBLIC_WINDOW_SEC="60"          # Window duration in seconds

# Authenticated User / Admin Endpoints (Looser limit)
RATE_LIMIT_AUTHENTICATED_MAX="150"         # Max requests per window
RATE_LIMIT_AUTHENTICATED_WINDOW_SEC="60"   # Window duration in seconds

# Strict Mutation Endpoints (Checkout orders, file uploads)
RATE_LIMIT_STRICT_MAX="10"                 # Max requests per window
RATE_LIMIT_STRICT_WINDOW_SEC="60"          # Window duration in seconds
