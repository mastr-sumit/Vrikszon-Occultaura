# ==============================================================================
# Vrikszon Occultaura — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Fill in your production credentials for each variable below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase / Neon / AWS RDS)
# ------------------------------------------------------------------------------
# Example: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Application & Public URLs
# ------------------------------------------------------------------------------
# Canonical production domain (e.g. https://vrikszon.com)
NEXT_PUBLIC_APP_URL=
SITE_URL=

# ------------------------------------------------------------------------------
# 3. NextAuth / Auth.js v5 Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32-character random key using: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
AUTH_TRUST_HOST=

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway
# ------------------------------------------------------------------------------
# Retrieve from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
# Set webhook endpoint URL to: https://<your-domain>/api/payments/webhook
# Subscribed events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# Retrieve from https://resend.com/api-keys
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# 6. Admin User Seeding (Used when running: npm run seed:admin)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ------------------------------------------------------------------------------
# 7. Rate Limiting & Security (Optional — sensible defaults built-in)
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_IP_MAX=
RATE_LIMIT_AUTH_IP_WINDOW_SEC=
RATE_LIMIT_AUTH_ACCOUNT_MAX=
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SEC=
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=
RATE_LIMIT_PUBLIC_MAX=
RATE_LIMIT_PUBLIC_WINDOW_SEC=
RATE_LIMIT_AUTHENTICATED_MAX=
RATE_LIMIT_AUTHENTICATED_WINDOW_SEC=
RATE_LIMIT_STRICT_MAX=
RATE_LIMIT_STRICT_WINDOW_SEC=
