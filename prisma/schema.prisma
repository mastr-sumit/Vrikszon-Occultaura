// Vrikszon Occultaura — Database Schema
// Dev: SQLite | Production: MySQL (change provider + DATABASE_URL when deploying)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Consultation Booking (from /book-consultation)
// ─────────────────────────────────────────────
model Booking {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String
  service        String // matches SERVICES id/name from src/data/services.ts
  preferredDate  DateTime?
  message        String?
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// Contact Form (from /contact)
// ─────────────────────────────────────────────
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    String // subject/reason dropdown from ContactForm.tsx
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([isRead])
}

// ─────────────────────────────────────────────
// Shop — Products & Orders (from /shop, /checkout)
// ─────────────────────────────────────────────
model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  category         String
  shortDescription String
  subtitle         String?
  benefits         String?     // store as JSON-stringified array since SQLite has no native array type
  price            Int? // INR, paise nahi — plain rupee value, null = price on request
  image            String?
  icon             String      @default("sparkles")
  featured         Boolean     @default(false)
  enabled          Boolean     @default(true)
  href             String?
  variantsNote     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
}

// ─────────────────────────────────────────────
// Academy / Courses (from /courses)
// ─────────────────────────────────────────────
model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String?
  image            String
  price            Int? // INR, null = price on request
  originalPrice    Int? // INR, null = no strike-through price
  shortDescription String
  enrollHref       String
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // human-readable, e.g. VO-20260801-0001
  fullName        String
  email           String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  pincode         String
  totalPrice      Int // INR
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) // stays UNPAID until Razorpay phase
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(1)
  price     Int // price at time of order (INR)
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ─────────────────────────────────────────────
// Testimonials (from /admin and homepage)
// ─────────────────────────────────────────────
model Testimonial {
  id                   String   @id @default(cuid())
  clientName           String
  clientRoleOrLocation String?
  quote                String?
  videoSrc             String?
  posterImage          String?
  featured             Boolean  @default(false)
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Admin (Phase 4 — dashboard access)
// ─────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

